generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// ─── User ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  firstName String?
  lastName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyMembers    FamilyMember[]
  createdTemplates Template[]
  receipts         Receipt[]
  savingsDeposits  SavingsDeposit[]
  createdEvents    Event[]

  @@map("users")
}

// ─── Family ───────────────────────────────────────────

model Family {
  id          String   @id @default(uuid())
  name        String
  currency    String   @default("PLN")
  tagMappings Json?    @default("{}") // Maps app functions to tag IDs: { income?: string, expense?: string, planning?: string, costs?: string, savings?: string }
  taxConfig   Json?    @default("{}") // Tax calculator config (form, rates, toggles)
  kanbanConfig Json?   @default("{}") // Kanban board columns and tag mappings
  dashboardConfig Json? @default("{}") // Dashboard settings (e.g. categoryFieldId)
  savingsConfig Json?  @default("{}") // Savings tab settings (autoCreateExpense, expenseTagId, templateData)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       FamilyMember[]
  categories    Category[]
  tagGroups     TagGroup[]
  templates     Template[]
  bills         Bill[]
  receipts      Receipt[]
  fixedExpenses FixedExpense[]
  savingsGoals  SavingsGoal[]
  stores        Store[]
  budgets       Budget[]
  events        Event[]
  taxEntries    TaxEntry[]
  companies          Company[]
  invoices           Invoice[]
  recurringInvoices  RecurringInvoice[]

  @@map("families")
}

model FamilyMember {
  id        String     @id @default(uuid())
  userId    String
  familyId  String
  role      FamilyRole @default(MEMBER)
  nickname  String?
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@map("family_members")
}

// ─── Categories ───────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  familyId  String
  name      String
  color     String   @default("#2ECC71")
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
  @@map("categories")
}

// ─── Tag Groups ───────────────────────────────────────

model TagGroup {
  id        String   @id @default(uuid())
  familyId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tags   Tag[]

  @@unique([familyId, name])
  @@map("tag_groups")
}

model Tag {
  id         String   @id @default(uuid())
  tagGroupId String
  name       String
  color      String   @default("#2ECC71")
  icon       String?
  imageUrl   String?  @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tagGroup TagGroup @relation(fields: [tagGroupId], references: [id], onDelete: Cascade)
  billTags BillTag[]
  beforePaymentBills Bill[] @relation("BillTagBeforePayment")
  afterPaymentBills Bill[]  @relation("BillTagAfterPayment")
  receiptTags ReceiptTag[]

  @@unique([tagGroupId, name])
  @@map("tags")
}

// ─── Schema Builder ───────────────────────────────────
// Architecture Decision: JSONB for dynamic schemas.
// columns is IColumnDefinition[] stored as JSONB:
// {
//   id: string, name: string,
//   type: 'text'|'number'|'date'|'checkbox'|'select'|'tags'|'currency'|'person'|'tag_group',
//   required: boolean, width?: number,
//   options?: string[], currencyOptions?: string[],
//   defaultBehavior: 'empty'|'today'|'copy_previous'|'last_used'|'current_user'|'checked'|'unchecked',
//   defaultValue?: string,  // e.g. specific date for 'date' type
//   tagGroupId?: string,    // for 'tag_group' type
//   defaultTagId?: string   // default tag in tag_group
// }
// This avoids EAV complexity while giving full flexibility.
// GIN indexes on JSONB enable efficient querying.

model Template {
  id          String   @id @default(uuid())
  familyId    String
  createdById String
  name        String
  description String?
  icon        String?
  columns     Json     // IColumnDefinition[]
  billingPeriod Json?  // IBillingPeriodConfig – billing period settings
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdById], references: [id])
  records   TemplateRecord[]
  billingPeriodOverrides BillingPeriodOverride[]

  @@map("templates")
}

model TemplateRecord {
  id         String   @id @default(uuid())
  templateId String
  data       Json     // { [columnId]: value }
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@map("template_records")
}

// ─── Billing Period Overrides ─────────────────────────

model BillingPeriodOverride {
  id                String   @id @default(uuid())
  templateId        String
  periodStart       DateTime // original period start
  overrideResetDate DateTime // overridden next reset date
  createdAt         DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, periodStart])
  @@map("billing_period_overrides")
}

// ─── Bills ────────────────────────────────────────────

enum PaymentType {
  MANUAL
  AUTO_PAY
  DIRECT_DEBIT
}

model Bill {
  id                String      @id @default(uuid())
  familyId          String
  name              String
  amount            Decimal     @db.Decimal(12, 2)
  currency          String      @default("PLN")
  dueDay            Int         // day of month (1-31)
  paymentStartDate  DateTime
  paymentEndDate    DateTime?
  frequency         Frequency   @default(MONTHLY)
  categoryId        String?
  notes             String?
  isActive          Boolean     @default(true)
  paymentType       PaymentType @default(MANUAL)
  autoCreateExpense Boolean     @default(false)
  reminderDays      Int         @default(3) // days before due to remind
  budgetLimit       Decimal?    @db.Decimal(12, 2) // alert threshold
  tagBeforePaymentId String?
  tagAfterPaymentId  String?
  savingsGoalId      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  family   Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments BillPayment[]
  tags     BillTag[]
  tagBeforePayment Tag? @relation("BillTagBeforePayment", fields: [tagBeforePaymentId], references: [id], onDelete: SetNull)
  tagAfterPayment  Tag? @relation("BillTagAfterPayment", fields: [tagAfterPaymentId], references: [id], onDelete: SetNull)
  savingsGoal      SavingsGoal? @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)

  @@map("bills")
}

model BillPayment {
  id      String   @id @default(uuid())
  billId  String
  amount  Decimal  @db.Decimal(12, 2)
  paidAt  DateTime @default(now())
  dueDate DateTime
  notes   String?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, dueDate])
  @@map("bill_payments")
}

model BillTag {
  id     String @id @default(uuid())
  billId String
  tagId  String

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([billId, tagId])
  @@map("bill_tags")
}

// ─── Receipts ─────────────────────────────────────────

model Receipt {
  id          String   @id @default(uuid())
  familyId    String
  userId      String
  storeId     String?
  billId      String?
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("PLN")
  date        DateTime
  categoryId  String?
  personId    String?
  imageUrl    String?
  notes       String?
  configurableFields Json? @default("{}") @map("configurable_fields")
  ocrStatus   ReceiptOcrStatus @default(COMPLETED)
  ocrError    String?
  isApproved  Boolean  @default(false)
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])
  store  Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items  ReceiptItem[]
  tags   ReceiptTag[]

  @@index([familyId, date])
  @@map("receipts")
}

enum ReceiptOcrStatus {
  PENDING
  COMPLETED
  FAILED
}

model ReceiptItem {
  id         String  @id @default(uuid())
  receiptId  String
  name       String
  quantity   Decimal @db.Decimal(10, 3) @default(1)
  unitPrice  Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)
  categoryId String?

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("receipt_items")
}

model ReceiptTag {
  id        String @id @default(uuid())
  receiptId String
  tagId     String

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([receiptId, tagId])
  @@map("receipt_tags")
}

// ─── Stores ──────────────────────────────────────────

model Store {
  id                String   @id @default(uuid())
  familyId          String
  name              String
  defaultCategoryId String?
  icon              String?
  address           String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  receipts Receipt[]

  @@unique([familyId, name])
  @@map("stores")
}

// ─── Budgets ─────────────────────────────────────────

model Budget {
  id         String   @id @default(uuid())
  familyId   String
  name       String
  month      Int      // 1-12
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  family     Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([familyId, month, year])
  @@map("budgets")
}

model BudgetCategory {
  id         String  @id @default(uuid())
  budgetId   String
  categoryId String
  limitAmount Decimal @db.Decimal(12, 2)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@map("budget_categories")
}

// ─── Fixed Expenses ───────────────────────────────────

model FixedExpense {
  id         String    @id @default(uuid())
  familyId   String
  name       String
  amount     Decimal   @db.Decimal(12, 2)
  currency   String    @default("PLN")
  frequency  Frequency @default(MONTHLY)
  dayOfMonth Int?
  startDate  DateTime
  endDate    DateTime?
  nextDueDate DateTime?
  lastPaidAt  DateTime?
  categoryId String?
  personId   String?
  paymentTagId String?
  paymentTemplateData Json? // Additional template-record payload to merge on "Pay"
  notes      String?
  savingsGoalId String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  savingsGoal SavingsGoal? @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)

  @@map("fixed_expenses")
}

// ─── Savings ──────────────────────────────────────────

model SavingsGoal {
  id           String    @id @default(uuid())
  familyId     String
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  currency     String    @default("PLN")
  deadline     DateTime?
  icon         String?
  color        String    @default("#2ECC71")
  autoCreateExpense Boolean @default(false)
  paymentTagId String?
  paymentTemplateData Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  family   Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  deposits SavingsDeposit[]
  bills    Bill[]
  fixedExpenses FixedExpense[]

  @@map("savings_goals")
}

model SavingsDeposit {
  id        String   @id @default(uuid())
  goalId    String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@map("savings_deposits")
}

// ─── Events ──────────────────────────────────────────

enum EventStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EventItemStatus {
  PENDING
  BOUGHT
  SKIPPED
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

model Event {
  id          String      @id @default(uuid())
  familyId    String
  createdById String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  budgetLimit Decimal?    @db.Decimal(12, 2)
  currency    String      @default("PLN")
  color       String      @default("#3B82F6")
  icon        String?
  location    String?
  status      EventStatus @default(PLANNED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id])
  items     EventItem[]
  todos     EventTodo[]
  notes     EventNote[]
  expenses  EventExpense[]
  splits    Split[]

  @@index([familyId, startDate])
  @@map("events")
}

model EventItem {
  id             String          @id @default(uuid())
  eventId        String
  name           String
  quantity       Decimal         @db.Decimal(10, 3) @default(1)
  estimatedPrice Decimal?        @db.Decimal(12, 2)
  actualPrice    Decimal?        @db.Decimal(12, 2)
  categoryId     String?
  assignedToId   String?
  status         EventItemStatus @default(PENDING)
  notes          String?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_items")
}

model EventTodo {
  id           String       @id @default(uuid())
  eventId      String
  title        String
  description  String?
  assignedToId String?
  dueDate      DateTime?
  priority     TodoPriority @default(MEDIUM)
  isCompleted  Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_todos")
}

model EventNote {
  id        String   @id @default(uuid())
  eventId   String
  title     String
  content   String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_notes")
}

model EventExpense {
  id         String   @id @default(uuid())
  eventId    String
  receiptId  String?
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("PLN")
  date       DateTime
  categoryId String?
  personId   String?
  notes      String?
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_expenses")
}

// ─── Tax Entries ──────────────────────────────────────

model TaxEntry {
  id               String    @id @default(uuid())
  familyId         String
  type             String    // ZUS, PIT, VAT_9M, CUSTOM
  name             String    // Display name
  month            Int       // 1-12
  year             Int
  calculatedAmount Decimal?  @db.Decimal(12, 2)
  amount           Decimal   @db.Decimal(12, 2)
  isPaid           Boolean   @default(false)
  paidAt           DateTime?
  notes            String?
  isRecurring      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, type, month, year, name])
  @@index([familyId, month, year])
  @@map("tax_entries")
}

// ─── Companies (Kontrahenci) ──────────────────────────

model Company {
  id          String   @id @default(uuid())
  familyId    String
  name        String
  nip         String?
  regon       String?
  address     String?
  city        String?
  postalCode  String?
  country     String   @default("Polska")
  email       String?
  phone       String?
  bankName    String?
  bankAccount String?
  isOwn       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family           Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invoicesAsSeller    Invoice[]          @relation("InvoiceSeller")
  invoicesAsBuyer     Invoice[]          @relation("InvoiceBuyer")
  recurringAsSeller   RecurringInvoice[] @relation("RecurringSeller")
  recurringAsBuyer    RecurringInvoice[] @relation("RecurringBuyer")

  @@unique([familyId, name])
  @@index([familyId])
  @@map("companies")
}

// ─── Invoices (Faktury) ───────────────────────────────

model Invoice {
  id            String   @id @default(uuid())
  familyId      String
  number        String
  type          String   @default("STANDARD") // STANDARD, PROFORMA, CORRECTION, ADVANCE, VAT_EXEMPT
  status        String   @default("DRAFT")    // DRAFT, ISSUED, SENT, PAID, OVERDUE, CANCELLED
  title         String?                       // Custom invoice title
  issuePlace    String?                       // Place of issue (Miejsce wystawienia)

  issueDate     DateTime
  saleDate      DateTime
  dueDate       DateTime

  sellerId      String
  buyerId       String

  paymentMethod String   @default("przelew")
  bankAccount   String?
  currency      String   @default("PLN")

  // Multi-currency support
  exchangeRate    Decimal? @db.Decimal(10, 4) // NBP exchange rate at issue date
  exchangeCurrency String?                    // Original currency if converted

  totalNet      Decimal  @db.Decimal(12, 2) @default(0)
  totalVat      Decimal  @db.Decimal(12, 2) @default(0)
  totalGross    Decimal  @db.Decimal(12, 2) @default(0)

  isPaid        Boolean  @default(false)
  paidAt        DateTime?
  paidAmount    Decimal? @db.Decimal(12, 2)

  correctedInvoiceId String?
  notes         String?

  // Email sending
  sentAt        DateTime?
  sentTo        String?

  // Recurring invoice source
  recurringInvoiceId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  family             Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  seller             Company            @relation("InvoiceSeller", fields: [sellerId], references: [id])
  buyer              Company            @relation("InvoiceBuyer", fields: [buyerId], references: [id])
  correctedInvoice   Invoice?           @relation("InvoiceCorrection", fields: [correctedInvoiceId], references: [id])
  corrections        Invoice[]          @relation("InvoiceCorrection")
  items              InvoiceItem[]
  auditLogs          InvoiceAuditLog[]
  recurringInvoice   RecurringInvoice?  @relation(fields: [recurringInvoiceId], references: [id])

  @@unique([familyId, number])
  @@index([familyId, status])
  @@index([familyId, issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  sortOrder   Int     @default(0)
  description String
  unit        String  @default("usł.")
  quantity    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(12, 2)
  vatRate     String  @default("23") // 23, 8, 5, 0, zw, np
  netAmount   Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @db.Decimal(12, 2)
  grossAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ─── Recurring Invoices (Faktury cykliczne) ───────────

model RecurringInvoice {
  id            String   @id @default(uuid())
  familyId      String
  name          String   // e.g. "Abonament Firma X"
  isActive      Boolean  @default(true)

  frequency     Frequency @default(MONTHLY) // DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextIssueDate DateTime
  lastIssuedAt  DateTime?

  // Invoice template data
  type          String   @default("STANDARD")
  sellerId      String
  buyerId       String
  paymentMethod String   @default("przelew")
  bankAccount   String?
  currency      String   @default("PLN")
  dueDays       Int      @default(14)  // Days after issue for payment
  notes         String?
  autoIssue     Boolean  @default(false) // Automatically issue (not just draft)
  autoSend      Boolean  @default(false) // Auto-send email on issue

  // Template items stored as JSON
  itemsTemplate Json     @default("[]") // Array of { description, unit, quantity, unitPrice, vatRate }

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  family        Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  seller        Company   @relation("RecurringSeller", fields: [sellerId], references: [id])
  buyer         Company   @relation("RecurringBuyer", fields: [buyerId], references: [id])
  invoices      Invoice[] // Generated invoices

  @@index([familyId, isActive])
  @@index([nextIssueDate])
  @@map("recurring_invoices")
}

// ─── Invoice Audit Log (Historia zmian) ───────────────

model InvoiceAuditLog {
  id         String   @id @default(uuid())
  invoiceId  String
  action     String   // CREATED, UPDATED, ISSUED, SENT, PAID, CANCELLED, CORRECTED, DELETED
  changes    Json?    // { field: { old, new } }
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_audit_logs")
}

// ─── Split (Expense Splitting) ────────────────────────

enum SplitStatus {
  ACTIVE
  SETTLED
  ARCHIVED
}

model Split {
  id          String      @id @default(uuid())
  eventId     String
  inviteCode  String      @unique // 8-char nanoid for share links
  name        String
  currency    String      @default("PLN")
  status      SplitStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants SplitParticipant[]
  messages     SplitMessage[]
  receipts     SplitReceipt[]

  @@index([eventId])
  @@index([inviteCode])
  @@map("splits")
}

model SplitParticipant {
  id         String   @id @default(uuid())
  splitId    String
  userId     String?  // null for guest participants
  nickname   String
  email      String?
  guestToken String?  @unique // auth token for guests (nanoid 32)
  isAdmin    Boolean  @default(false)
  isSettled  Boolean  @default(false)
  createdAt  DateTime @default(now())

  split    Split             @relation(fields: [splitId], references: [id], onDelete: Cascade)
  messages SplitMessage[]
  claims   SplitItemClaim[]
  paidReceipts SplitReceipt[] @relation("SplitReceiptPaidBy")

  @@unique([splitId, userId]) // one participation per user per split
  @@index([splitId])
  @@index([guestToken])
  @@map("split_participants")
}

model SplitMessage {
  id             String   @id @default(uuid())
  splitId        String
  participantId  String
  content        String?  @db.Text // text content (null for receipt-only messages)
  type           String   @default("TEXT") // TEXT or RECEIPT
  splitReceiptId String?  // link to receipt if type=RECEIPT
  createdAt      DateTime @default(now())

  split       Split            @relation(fields: [splitId], references: [id], onDelete: Cascade)
  participant SplitParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([splitId, createdAt])
  @@map("split_messages")
}

model SplitReceipt {
  id                  String   @id @default(uuid())
  splitId             String
  uploadedByParticipantId String
  paidByParticipantId String
  imageUrl            String?  @db.Text
  storeName           String?
  totalAmount         Decimal  @db.Decimal(12, 2)
  isConfirmed         Boolean  @default(false)
  ocrRawText          String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  split       Split            @relation(fields: [splitId], references: [id], onDelete: Cascade)
  paidBy      SplitParticipant @relation("SplitReceiptPaidBy", fields: [paidByParticipantId], references: [id])
  items       SplitReceiptItem[]

  @@index([splitId])
  @@map("split_receipts")
}

model SplitReceiptItem {
  id              String  @id @default(uuid())
  splitReceiptId  String
  name            String
  quantity        Decimal @db.Decimal(10, 3) @default(1)
  unitPrice       Decimal @db.Decimal(12, 2)
  total           Decimal @db.Decimal(12, 2)
  sortOrder       Int     @default(0)

  splitReceipt SplitReceipt   @relation(fields: [splitReceiptId], references: [id], onDelete: Cascade)
  claims       SplitItemClaim[]

  @@index([splitReceiptId])
  @@map("split_receipt_items")
}

model SplitItemClaim {
  id                  String @id @default(uuid())
  splitReceiptItemId  String
  participantId       String
  createdAt           DateTime @default(now())

  splitReceiptItem SplitReceiptItem @relation(fields: [splitReceiptItemId], references: [id], onDelete: Cascade)
  participant      SplitParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([splitReceiptItemId, participantId]) // one claim per participant per item
  @@index([splitReceiptItemId])
  @@map("split_item_claims")
}
